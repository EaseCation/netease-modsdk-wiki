    {
      "id": "world.data",
      "label": "世界数据持久化与读取",
      "concepts": [
        "world_data",
        "custom_data",
        "persistence"
      ],
      "triggers": [
        [
          "world_data",
          "persistence"
        ]
      ],
      "side": "server",
      "operations": [
        "write",
        "set"
      ],
      "modes": [
        "workflow"
      ],
      "status": "matched",
      "steps": [
        {
          "label": "使用 levelId 创建数据组件并按键写入",
          "ids": [
            "modsdk:api:server:mod.server.component.exDataCompServer.ExDataCompServer.SetExtraData@mcdocs/1-ModAPI/接口/世界/自定义数据.md"
          ]
        },
        {
          "label": "重新进入后使用同一归属和键读取",
          "ids": [
            "modsdk:api:server:mod.server.component.exDataCompServer.ExDataCompServer.GetExtraData@mcdocs/1-ModAPI/接口/世界/自定义数据.md"
          ]
        }
      ],
      "cautions": [
        "默认 autoSave=True；批量关闭自动保存时，全部写入后调用 SaveExtraData 并检查返回结果。",
        "使用 levelId 创建组件；实体 ID 和方块实体数据不能替代世界数据。"
      ],
      "guides": [
        "mcdocs/1-ModAPI/接口/世界/自定义数据.md"
      ],
      "source_dependencies": {
        "modsdk:api:server:mod.server.component.exDataCompServer.ExDataCompServer.SetExtraData@mcdocs/1-ModAPI/接口/世界/自定义数据.md": "2c4c7a251f8c7116270ac173d739359672c5c55144ac1298fd03929e74870e72",
